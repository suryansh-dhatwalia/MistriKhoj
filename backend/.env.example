NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_SESSION_DAYS=7
ADMIN_COOKIE_SAME_SITE=lax
# Optional: set only when the API and admin need a shared parent cookie domain.
ADMIN_COOKIE_DOMAIN=
SHUTDOWN_TIMEOUT_MS=10000

# Replace these placeholders. Encode special password characters in the URL.
DATABASE_URL="mysql://username:password@127.0.0.1:3306/mistrikhoj"

# Required when a user uploads a new image from the registration form.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used only by `npm run admin:create`. Remove the password after creating the account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=

# After `npx prisma migrate deploy`, run `npm run content:seed` once to populate the
# CMS tables (states, cities, categories, plans, testimonials, ads, referrals, settings)
# from the data the public site previously hard-coded. Safe to re-run: it only adds
# missing rows and never overwrites edits made in the admin dashboard.
