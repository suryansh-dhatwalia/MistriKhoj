{
  "name": "backend",
  "version": "1.0.0",
  "description": "MistriKhoj API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "start:dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test src/schemas/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "content:seed": "tsx src/scripts/seed-content.ts"
  },
  "keywords": [],
  "author": "",
