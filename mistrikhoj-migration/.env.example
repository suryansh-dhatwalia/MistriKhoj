# ---- Legacy database (the dbmistri.sql dump, restored into its own scratch/staging DB) ----
# Never point this at anything you care about breaking — it's read-only for this script.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=dbmistri_legacy

# ---- New database (your current mistrikhoj/Prisma schema) ----
# Run this whole migration against a STAGING copy first, not production.
NEW_DB_HOST=127.0.0.1
NEW_DB_PORT=3306
NEW_DB_USER=root
NEW_DB_PASSWORD=
NEW_DB_NAME=mistrikhoj_staging

# ---- Cloudinary (for re-hosting mistri photos, gallery images, and ad banners) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Folder on disk (or mounted volume) containing the OLD server's uploaded images.
# This is NOT in the SQL dump — the dump only has filenames like "8365450.jpg".
# Point this at wherever those files actually live (old server's uploads directory).
OLD_UPLOADS_DIR=./old-uploads

# Where the filename -> Cloudinary URL map gets written/read from.
IMAGE_MAP_FILE=./image-map.json

# Used as a stand-in when a mistri's profile_photo_url can't be found in the image map
# (profile_photo_url is required and NOT NULL in the new schema, so something must go here).
FALLBACK_PROFILE_PHOTO_URL=https://res.cloudinary.com/demo/image/upload/v1/sample.jpg
